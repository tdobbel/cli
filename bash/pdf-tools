#!/usr/bin/env bash

read -r -d '' HELP_MSG <<EOF
CLI to process pdf files

\e[4m\e[1mUsage\e[0m: pdf-tools <COMMAND> [args...]

\e[4m\e[1mCommands\e[0m:
  compress  <in-pdf> <output-pdf>
  decrypt   <in-pdf>
  extract   <in-pdf> <start-page> <end-page>
  merge     <out-pdf> [<input-pdf>...]
  help      Display this message
EOF

error-log() {
    echo -e "\e[31mError: $1\e[0m\n" >&2
}

compress-pdf() {
    if (($# != 2)); then
        error-log "Usage: pdf-tools compress <input.pdf> <output.pdf>"
        return 1
    fi

    gs -sDEVICE=pdfwrite -dCompatibilityLevel=1.4 -dPDFSETTINGS=/default -dQUIET -dDetectDuplicateImages -dCompressFonts=true -r150 -o "$2" "$1"
}

extract-pages() {
    if (($# != 3)); then
        error-log "Usage: pdf-tools extract <input.pdf> <start_page> <end_page>"
        return 1
    fi
    gs -sDEVICE=pdfwrite -dNOPAUSE -dBATCH -dSAFER \
        -dFirstPage="${2}" \
        -dLastPage="${3}" \
        -sOutputFile="${1%.pdf}_p${2}-p${3}.pdf" \
        "${1}"
}

merge-files() {
    if (($# < 3)); then
        error-log "Usage: pdf-tools merge <output.pdf> <input1.pdf> <input2.pdf> ..."
        return 1
    fi
    gs -dBATCH -dNOPAUSE -q -sDEVICE=pdfwrite -sOutputFile="$1" "${@:2}"
}

decrypt-file() {
    if (($# != 1)); then
        error-log "Usage: pdf-tools decrypt <input.pdf>"
        return 1
    fi
    local decripted="${1%.pdf}_decrypted.pdf"
    LD_LIBRARY_PATH=/snap/cups/1100/usr/lib qpdf --decrypt "$1" "$decripted"
}

main() {
    local cmd="$1"
    case "$cmd" in
    "compress")
        compress-pdf "${@:2}"
        ;;
    "extract")
        extract-pages "${@:2}"
        ;;
    "merge")
        merge-files "${@:2}"
        ;;
    "decrypt")
        decrypt-file "${@:2}"
        ;;
    "help")
        echo -e "$HELP_MSG"
        ;;
    *)
        error-log "Unknown command '$cmd'"
        echo -e "$HELP_MSG" >&2
        return 1
        ;;
    esac
}

main "$@"
